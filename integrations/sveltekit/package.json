{
  "name": "@easeo/sveltekit",
  "version": "0.1.1",
  "description": "easeo integration for SvelteKit",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "svelte": "./index.js",
  "keywords": [
    "seo",
    "sveltekit",
    "svelte",
    "metadata",
    "open-graph",
    "json-ld"
  ],
  "homepage": "https://easeo.emiliano-go.com/integrations/sveltekit/",
  "bugs": {
    "url": "https://github.com/emiliano-go/easeo/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "svelte": "./index.js",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./EaseoHead.svelte": {
      "svelte": "./EaseoHead.svelte",
      "default": "./EaseoHead.svelte"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "EaseoHead.svelte"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emiliano-go/easeo.git",
    "directory": "integrations/sveltekit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@easeo/core": "^0.1.0",
    "svelte": ">=4.0.0"
  }
}
