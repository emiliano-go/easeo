{
  "name": "@easeo/core",
  "version": "0.2.0",
  "description": "Deterministic SEO payload generation for content platforms",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "keywords": [
    "seo",
    "canonical-url",
    "open-graph",
    "twitter-cards",
    "json-ld",
    "metadata"
  ],
  "homepage": "https://easeo.emiliano-go.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emiliano-go/easeo.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/emiliano-go/easeo/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "native.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "bash ../../scripts/generate_node_bindings.sh"
  },
  "napi": {
    "binaryName": "easeo"
  },
  "cargo": {
    "package": "easeo-node",
    "manifestPath": "../../crates/easeo-node/Cargo.toml"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
