{
  "name": "@easeo/core",
  "version": "0.1.0",
  "description": "Deterministic SEO payload generation for content platforms",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emiliano-go/easeo"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "build": "napi build --release",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "napi": {
    "name": "easeo",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "cargo": {
    "package": "easeo-node",
    "manifestPath": "../../crates/easeo-node/Cargo.toml"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
